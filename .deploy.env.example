# Copy to .deploy.env and fill in your server details
DEPLOY_SSH_KEY="$HOME/.ssh/your-key.key"
DEPLOY_USER="opc"
DEPLOY_HOST="your.server.ip.address"
DEPLOY_SERVER_ROOT="/home/opc/mc"
DEPLOY_REMOTE_DIR="/home/opc/mc/plugins"
PLUGIN_JAR_NAME="shycubes.jar"
LOCAL_BACKUP_DIR="server_data"
APP_LOG_LEVEL="INFO"
OTEL_SERVICE_NAME="shyCubesLogs"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
