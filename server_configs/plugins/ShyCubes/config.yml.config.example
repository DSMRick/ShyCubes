# ShyCubes Configuration
database:
  file: players.db
  flush-interval-seconds: 5

leaderboard:
  # Auto-spawn near world spawn if no location is set yet
  auto-place-at-spawn: true
  spawn-offset:
    x: 0.5
    y: 2.8
    z: 3.5
  update-interval-seconds: 2
  # Set via '/leaderboard here' in-game (or manually below)
  location:
    enabled: true
    world: world
    x: 0.5
    y: 66.8
    z: 51.5
billboards:
  topblocks:
    enabled: true
    stat: top_blocks
    order: DESC
    entries: 10
    unit: ''
    header:
    - §6§l✦ §e§lTOP 10 TOP BLOCKS §6§l✦
    - §7ShyCubes Leaderboard
    auto-place-at-spawn: false
    spawn-offset:
      x: 0.5
      y: 2.8
      z: 3.5
    location:
      world: world
      x: -184.5
      y: 82.8
      z: 507.5
